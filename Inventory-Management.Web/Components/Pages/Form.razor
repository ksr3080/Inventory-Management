@page "/form"
@using System.Security.Claims
@using Inventory_Management.Interface
@using Inventory_Management.Service
@using Inventory_Management.Shared.DTOs.Forms
@using Inventory_Management.Shared.Helper.FormAccessCode
@using Inventory_Management.ViewModels
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject IFormService FormService
@inject SessionContext SessionContext

<PageTitle>Form Master</PageTitle>

@if (!CanView("/form"))
{
    <div class="container-fluid mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="alert alert-danger text-center shadow-sm">
                    <h4>Access Denied</h4>
                    <p>You don't have permission to access this page.</p>
                    <Button Color="ButtonColor.Primary" @onclick="GoHome">
                        Go to Home
                    </Button>
                </div>
            </div>
        </div>
    </div>
}
else
{
    @if (isLoading)
    {
        <div class="text-center my-5">
            <Spinner Type="SpinnerType.Border" Color="SpinnerColor.Primary" />
            <p class="text-muted mt-2">Loading forms...</p>
        </div>
    }
    else
    {
        <div class="container-fluid py-3">
            <div class="row mb-4 align-items-center">
                <div class="col">
                    <h3 class="fw-bold text-dark m-0">
                        <Icon Name="IconName.FileEarmarkText" class="me-2 text-primary" /> Form Master
                    </h3>
                </div>
                <div class="col-auto">
                    <span title="@(!CanCreate(Route) ? "You do not have permission to perform this action." : "")">
                        <Button Color="ButtonColor.Primary"
                                @onclick="ShowAddModal"
                                Disabled="@(!CanCreate(Route))"
                                class="shadow-sm">
                            <Icon Name="IconName.Plus" class="me-1" /> Add New
                        </Button>
                    </span>
                </div>
            </div>

            @if (formList.Any())
            {
                <Grid TItem="FormsModel"
                      Class="table table-hover table-bordered table-striped shadow-sm"
                      Data="formList"
                      AllowPaging="true"
                      PageSize="10"
                      Responsive="true"
                      AllowFiltering="true"
                      AllowSorting="true"
                      @ref="FormGrid">

                    <GridColumn TItem="FormsModel" HeaderText="No" Filterable="false" HeaderCellClass="text-center" CellClass="text-center">
                        @(formList.IndexOf(context) + 1)
                    </GridColumn>

                    <GridColumn TItem="FormsModel" HeaderText="Form Code" PropertyName="FormCode" SortString="FormCode" SortKeySelector="item => item.FormCode" FilterTextboxWidth="100">
                        <span class="badge bg-light text-dark border fw-semibold">@context.FormCode</span>
                    </GridColumn>

                    <GridColumn TItem="FormsModel" HeaderText="Form Name" PropertyName="FormName" SortString="FormName" SortKeySelector="item => item.FormName" FilterTextboxWidth="120">
                        <span class="fw-bold text-secondary">@context.FormName</span>
                    </GridColumn>

                    <GridColumn TItem="FormsModel" HeaderText="Route" PropertyName="Route" SortString="Route" SortKeySelector="item => item.Route" FilterTextboxWidth="120">
                        <code>@context.Route</code>
                    </GridColumn>

                    <GridColumn TItem="FormsModel" HeaderText="ParentForm" PropertyName="ParentName" SortString="ParentName" SortKeySelector="item => item.ParentName" FilterTextboxWidth="120">
                        @if (string.IsNullOrEmpty(context.ParentName))
                        {
                            <span class="text-muted small">None</span>
                        }
                        else
                        {
                            <span class="text-primary fw-medium">@context.ParentName</span>
                        }
                    </GridColumn>

                    <GridColumn TItem="FormsModel" HeaderText="Display Order" PropertyName="DisplayIndex" SortString="DisplayIndex" SortKeySelector="item => item.DisplayIndex" FilterTextboxWidth="60" HeaderCellClass="text-center" CellClass="text-center">
                        <span class="badge bg-primary">@context.DisplayIndex</span>
                    </GridColumn>

                    <GridColumn TItem="FormsModel" HeaderText="Show In Menu" Filterable="false" HeaderCellClass="text-center" CellClass="text-center">
                        @if (context.ShowInMenu)
                        {
                            <Badge Color="BadgeColor.Success">Yes</Badge>
                        }
                        else
                        {
                            <Badge Color="BadgeColor.Secondary">No</Badge>
                        }
                    </GridColumn>

                    <GridColumn TItem="FormsModel" HeaderText="Actions" Filterable="false">
                        <div class="d-flex gap-1 justify-content-center">
                            <span title="@(!CanEdit(Route) ? "You do not have permission to perform this action." : "")">
                                <Button class="text-nowrap"
                                        Color="ButtonColor.Warning"
                                        Size="ButtonSize.Small"
                                        Disabled="@(!CanEdit(Route))"
                                        @onclick="() => ShowEditModal(context)">
                                    <Icon Name="IconName.PencilSquare" /> Edit
                                </Button>
                            </span>

                            <span title="@(!CanDelete(Route) ? "You do not have permission to perform this action." : "")">
                                <LoadingButton Class="text-nowrap"
                                               Color="ButtonColor.Danger"
                                               Size="ButtonSize.Small"
                                               Disabled="@(!CanDelete(Route))"
                                               OnClick="() => DeleteForm(context.Id)">
                                    <Icon Name="IconName.Trash" /> Delete
                                </LoadingButton>
                            </span>
                        </div>
                    </GridColumn>
                </Grid>
            }
            else
            {
                <div class="alert alert-info text-center shadow-sm">
                    No forms found. Click "Add New" to create one.
                </div>
            }
        </div>
    }
}

<Modal @ref="modal" Title="@modalTitle" Size="ModalSize.Large" UseStaticBackdrop>
    <BodyTemplate>
        @if (editContext != null)
        {
            <EditForm EditContext="@editContext" OnSubmit="SaveForm">
                <DataAnnotationsValidator />

                <div class="row">
                    <!-- Form Code -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold text-secondary">
                            Form Code <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text"><Icon Name="IconName.Code" /></span>
                            <InputText class="form-control"
                                       @bind-Value="FormsModel.FormCode"
                                       placeholder="e.g. USER_MASTER" />
                        </div>
                        <ValidationMessage For="@(() => FormsModel.FormCode)" class="text-danger small" />
                    </div>

                    <!-- Form Name -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold text-secondary">
                            Form Name <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text"><Icon Name="IconName.FileText" /></span>
                            <InputText class="form-control"
                                       @bind-Value="FormsModel.FormName"
                                       @oninput="(e) => HandleNameChangeAsync(e.Value?.ToString())"
                                       placeholder="e.g. User Master" />
                        </div>
                        <ValidationMessage For="@(() => FormsModel.FormName)" class="text-danger small" />
                    </div>
                </div>

                <div class="row">
                    <!-- Form Route -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold text-secondary">
                            Form Route <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text"><Icon Name="IconName.Link" /></span>
                            <InputText class="form-control"
                                       @bind-Value="FormsModel.Route"
                                       placeholder="e.g. /users" />
                        </div>
                        <ValidationMessage For="@(() => FormsModel.Route)" class="text-danger small" />
                    </div>

                    <!-- Parent Form -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold text-secondary">Parent Form</label>
                        <div class="input-group">
                            <span class="input-group-text"><Icon Name="IconName.Diagram3" /></span>
                            <InputSelect class="form-select" @bind-Value="FormsModel.ParentId">
                                <option value="0">-- Select Parent Form --</option>
                                @foreach (var form in breadCumList.Where(b => b.FormId != FormsModel.Id))
                                {
                                    <option value="@form.FormId">@form.BreadCum</option>
                                }
                            </InputSelect>
                        </div>
                        <ValidationMessage For="@(() => FormsModel.ParentId)" class="text-danger small" />
                    </div>
                </div>

                <div class="row">
                    <!-- Display Order -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold text-secondary">
                            Display Order <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text"><Icon Name="IconName.SortNumericDown" /></span>
                            <InputNumber class="form-control"
                                         @bind-Value="FormsModel.DisplayIndex"
                                         @oninput="HandleDisplayIndexChangeAsync" />
                        </div>
                        <ValidationMessage For="@(() => FormsModel.DisplayIndex)" class="text-danger small" />
                    </div>

                    <!-- Menu Icon -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold text-secondary">Menu Icon</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                @if (GetIcon(FormsModel.Icon) is IconName currentIcon)
                                {
                                    <Icon Name="@currentIcon" />
                                }
                                else
                                {
                                    <Icon Name="IconName.AppIndicator" />
                                }
                            </span>
                            <InputText class="form-control"
                                       @bind-Value="FormsModel.Icon"
                                       placeholder="e.g. People, Trash, Gear..." />
                        </div>
                        <ValidationMessage For="@(() => FormsModel.Icon)" class="text-danger small" />
                    </div>
                </div>

                <!-- Checkbox Option Container -->
                <div class="card border-0 bg-light p-3 mb-4 rounded-3 shadow-sm">
                    <h6 class="text-primary mb-3 fw-bold"><Icon Name="IconName.GearWideConnected" class="me-1" /> Form Options & Permissions</h6>
                    <div class="row">
                        <div class="col-md-3 col-sm-6 mb-2">
                            <div class="form-check form-switch">
                                <InputCheckbox class="form-check-input" id="chkShowInMenu" @bind-Value="FormsModel.ShowInMenu" />
                                <label class="form-check-label fw-semibold" for="chkShowInMenu">Show In Menu</label>
                            </div>
                        </div>
                        @if (FormsModel.Id > 0)
                        {
                            <div class="col-md-3 col-sm-6 mb-2">
                                <div class="form-check form-switch">
                                    <InputCheckbox class="form-check-input" id="chkIsActive" @bind-Value="FormsModel.IsActive" />
                                    <label class="form-check-label fw-semibold" for="chkIsActive">Active</label>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="text-end border-top pt-3">
                    <Button Color="ButtonColor.Secondary" @onclick="HideModal" class="me-1">Cancel</Button>
                    <Button Color="ButtonColor.Primary" Type="ButtonType.Submit">
                        @if (isSaveBtnLoading)
                        {
                            <Spinner Size="SpinnerSize.Small" class="me-1" />
                        }
                        Save
                    </Button>
                </div>
            </EditForm>
        }
    </BodyTemplate>
</Modal>

@code {
    private Modal modal = default!;
    private bool isEditMode;
    private bool isLoading = true;

    private string modalTitle = "Add Form";
    private string Route = "/form";

    private FormsModel FormsModel = new();
    private List<FormsModel> formList = new();
    private List<FormBreadCumDTO> breadCumList = new();

    private Grid<FormsModel> FormGrid = default!;

    private EditContext editContext = default!;
    private ValidationMessageStore validationMessage = default!;
    private bool isSaveBtnLoading = false;

    // Authorization & Authentication helpers
    private bool CanView(string route) => SessionContext.HasPermission(FormAccessCode.FORMS, Form_BusinessRules.VIEW);
    private bool CanCreate(string route) => SessionContext.HasPermission(FormAccessCode.FORMS, Form_BusinessRules.ADD);
    private bool CanEdit(string route) => SessionContext.HasPermission(FormAccessCode.FORMS, Form_BusinessRules.EDIT);
    private bool CanDelete(string route) => SessionContext.HasPermission(FormAccessCode.FORMS, Form_BusinessRules.DELETE);
    private int UserId => SessionContext.UserId;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await LoadForms();
    }

    private async Task LoadForms()
    {
        try
        {
            isLoading = true;
            var result = await FormService.GetFormsAsync();
            formList = result.Select(f => new FormsModel
            {
                Id = f.Id,
                FormCode = f.FormCode,
                FormName = f.FormName,
                Route = f.FormUrl ?? string.Empty,
                DisplayIndex = f.DisplayIndex,
                Icon = f.MenuIconClass ?? string.Empty,
                ParentId = f.ParentId ?? 0,
                ShowInMenu = f.ShowInMenu,
                IsAddEdit = f.IsAddEdit ?? false,
                IsView = f.IsView ?? false,
                IsActive = f.IsActive
            }).ToList();

            var formMap = formList.ToDictionary(f => f.Id, f => f.FormName);
            foreach (var f in formList)
            {
                f.ParentName = f.ParentId > 0 && formMap.ContainsKey(f.ParentId) ? formMap[f.ParentId] : string.Empty;
            }

            breadCumList = (await FormService.GetFormBreadCumsAsync()).ToList();
            isLoading = false;
        }
        catch (Exception ex)
        {
            isLoading = false;
            await JS.InvokeVoidAsync("console.error", "Error loading forms:", ex.ToString());
            await JS.InvokeVoidAsync("alert", "Error loading forms: " + ex.Message);
        }
    }

    private void InitializeEditContext()
    {
        editContext = new EditContext(FormsModel);
        validationMessage = new ValidationMessageStore(editContext);
    }

    private async Task ShowAddModal()
    {
        modalTitle = "Add Form";
        isEditMode = false;

        FormsModel = new FormsModel
        {
            FormCode = string.Empty,
            FormName = string.Empty,
            Route = string.Empty,
            DisplayIndex = 1,
            Icon = string.Empty,
            ParentId = 0,
            ShowInMenu = true,
            IsAddEdit = false,
            IsView = false,
            IsActive = true,
            CreatedBy = UserId
        };

        InitializeEditContext();
        await modal.ShowAsync();
    }

    private async Task ShowEditModal(FormsModel model)
    {
        modalTitle = "Edit Form";
        isEditMode = true;

        FormsModel = new FormsModel
        {
            Id = model.Id,
            FormCode = model.FormCode,
            FormName = model.FormName,
            Route = model.Route,
            DisplayIndex = model.DisplayIndex,
            Icon = model.Icon,
            ParentId = model.ParentId,
            ParentName = model.ParentName,
            ShowInMenu = model.ShowInMenu,
            IsAddEdit = model.IsAddEdit,
            IsView = model.IsView,
            IsActive = model.IsActive,
            UpdatedBy = UserId
        };

        InitializeEditContext();
        await modal.ShowAsync();
    }

    private async Task SaveForm()
    {
        if (isSaveBtnLoading) return;
        try
        {
            isSaveBtnLoading = true;
            if (!editContext.Validate())
            {
                var validationErrors = editContext.GetValidationMessages();
                var errorMsg = string.Join("\n", validationErrors);
                await JS.InvokeVoidAsync("console.warn", "Form validation failed:\n" + errorMsg);
                await JS.InvokeVoidAsync("alert", "Validation Failed:\n" + errorMsg);
                return;
            }

            FormsModel.ParentName = formList.FirstOrDefault(f => f.Id == FormsModel.ParentId)?.FormName ?? string.Empty;
            if (isEditMode)
            {
                var updateDto = new UpdateFormDTO
                {
                    Id = FormsModel.Id,
                    FormCode = FormsModel.FormCode,
                    FormName = FormsModel.FormName,
                    ParentId = FormsModel.ParentId > 0 ? FormsModel.ParentId : 0,
                    FormUrl = FormsModel.Route,
                    MenuIconClass = FormsModel.Icon,
                    ShowInMenu = FormsModel.ShowInMenu,
                    IsAddEdit = FormsModel.IsAddEdit,
                    IsView = FormsModel.IsView,
                    DisplayIndex = FormsModel.DisplayIndex,
                    UpdatedBy = SessionContext.UserId
                };
                await FormService.UpdateFormAsync(updateDto);
            }
            else
            {
                var createDto = new CreateFormDTO
                {
                    FormCode = FormsModel.FormCode,
                    FormName = FormsModel.FormName,
                    ParentId = FormsModel.ParentId > 0 ? FormsModel.ParentId : 0,
                    FormUrl = FormsModel.Route,
                    MenuIconClass = FormsModel.Icon,
                    ShowInMenu = FormsModel.ShowInMenu,
                    IsAddEdit = FormsModel.IsAddEdit,
                    IsView = FormsModel.IsView,
                    DisplayIndex = FormsModel.DisplayIndex,
                    CreatedBy = SessionContext.UserId
                };
                await FormService.CreateFormAsync(createDto);
            }

            await HideModal();
            await LoadForms();
            if (FormGrid != null)
                await FormGrid.RefreshDataAsync();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", "Error saving form:", ex.ToString());
            await JS.InvokeVoidAsync("alert", "Error saving form: " + ex.Message);
        }
        finally
        {
            isSaveBtnLoading = false;
        }
    }

    private async Task DeleteForm(int id)
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete?");
        if (!confirm) return;

        try
        {
            await FormService.DeleteFormAsync(id);
            await LoadForms();
            if (FormGrid != null)
                await FormGrid.RefreshDataAsync();
        }
        catch (Exception) { }
    }

    private async Task HideModal()
    {
        await modal.HideAsync();
    }

    private async Task ValidateDuplicateNameAsync()
    {
        validationMessage.Clear(() => FormsModel.FormName);

        if (!string.IsNullOrWhiteSpace(FormsModel.FormName))
        {
            var isUnique = !formList.Any(f => f.FormName.Equals(FormsModel.FormName, StringComparison.OrdinalIgnoreCase) && f.Id != FormsModel.Id);
            if (!isUnique)
                validationMessage.Add(() => FormsModel.FormName, "Form name already exists");

            editContext.NotifyValidationStateChanged();
        }
        await Task.CompletedTask;
    }

    private async Task ValidateDisplayIndexAsync()
    {
        validationMessage.Clear(() => FormsModel.DisplayIndex);
        if (FormsModel.DisplayIndex == 0)
        {
            validationMessage.Add(() => FormsModel.DisplayIndex, "Display index must be greater than 0");
        }
        editContext.NotifyValidationStateChanged();
        await Task.CompletedTask;
    }

    private async Task ValidateIsDisplayIndexInUseAsync()
    {
        validationMessage.Clear(() => FormsModel.DisplayIndex);
        var isUnique = !formList.Any(f => f.DisplayIndex == FormsModel.DisplayIndex && f.ParentId == FormsModel.ParentId && f.Id != FormsModel.Id);

        if (!isUnique)
        {
            validationMessage.Add(
                () => FormsModel.DisplayIndex,
                "Display Index already exists");
        }
        editContext.NotifyValidationStateChanged();
        await Task.CompletedTask;
    }

    private async Task HandleNameChangeAsync(string? value)
    {
        FormsModel.FormName = value ?? string.Empty;
        await ValidateDuplicateNameAsync();
    }

    private async Task HandleDisplayIndexChangeAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int index))
        {
            FormsModel.DisplayIndex = index;
            await ValidateDisplayIndexAsync();
        }
    }

    private IconName? GetIcon(string icon)
    {
        if (string.IsNullOrWhiteSpace(icon))
            return null;

        return Enum.TryParse<IconName>(icon, out var result)
            ? result
            : null;
    }

    private void GoHome()
    {
        NavigationManager.NavigateTo("/admin");
    }
}