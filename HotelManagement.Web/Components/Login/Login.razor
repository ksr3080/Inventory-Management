@page "/"
@layout LoginLayout
@inject ILogger<Login> Logger
@inject NavigationManager NavigationManager
@inject IAuthService AuthService
@inject IFormService FormService
@inject IFormRulesPermissionService FormRulesPermissionService
@inject IFormBusinessRulesService FormBusinessRulesService
@inject SessionContext SessionContext
@using System.ComponentModel.DataAnnotations
@using HotelManagement.Interface
@using HotelManagement.Service
@using HotelManagement.Shared.DTOs.Auth

<PageTitle>Arna Technosoft - Login</PageTitle>

<div class="login-container">
    <div class="login-box">
        <div class="login-header">
            <div class="logo-container">
                <img src="images/ArnaLogo.png" alt="Arna Technosoft" class="logo" />
            </div>
        </div>



        <div class="login-body">
            <p class="login-message">Sign in to start your session</p>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger mb-3" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    @errorMessage
                </div>
            }

            <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <div class="input-container">
                        <span class="input-icon">
                            <Icon Name="IconName.Envelope" />
                        </span>
                        <InputText @bind-Value="loginModel.Username"
                                   class="form-input"
                                   placeholder="User Name" autofocus />
                    </div>
                    <ValidationMessage For="@(() => loginModel.Username)" class="text-danger small mt-1" />
                </div>

                <div class="form-group">
                    <div class="input-container">
                        <span class="input-icon">
                            <Icon Name="IconName.Lock" />
                        </span>
                        <InputText @bind-Value="loginModel.Password"
                                   class="form-input"
                                   placeholder="Password"
                                   type="@passwordInputType" />
                        <button type="button" class="password-toggle" @onclick="TogglePasswordVisibility">
                            <i class="@passwordToggleIcon"></i>
                        </button>
                    </div>
                    <ValidationMessage For="@(() => loginModel.Password)" class="text-danger small mt-1" />
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary login-btn" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        }
                        SIGN IN
                    </button>
                </div>
            </EditForm>
        </div>
    </div>

</div>



@code {
    private LoginModel loginModel = new();
    private string? errorMessage;
    private bool isLoading;
    private bool showPassword;
    private CancellationTokenSource _cts = new();

    private string passwordInputType => showPassword ? "text" : "password";
    private string passwordToggleIcon => showPassword ? "bi bi-eye-slash" : "bi bi-eye";

    protected override async Task OnInitializedAsync()
    {
        if (!SessionContext.IsAuthenticated)
        {
            await SessionContext.TryRestoreSessionAsync();
        }

        if (SessionContext.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/home");
        }
    }

    private async Task HandleLogin()
    {
        if (isLoading) return;
        try
        {
            isLoading = true;
            errorMessage = null;
            await Task.Yield();
            StateHasChanged();

            var request = new LoginRequestDTO
            {
                UserNameOrEmail = loginModel.Username,
                Password = loginModel.Password
            };

            var response = await AuthService.LoginAsync(request, _cts.Token);

            if (response != null && !string.IsNullOrEmpty(response.Token))
            {
                await SessionContext.SaveSessionAsync(response);

                var forms = await FormService.GetFormsAsync();
                SessionContext.LoadForms(forms);

                var permissions = await FormRulesPermissionService.GetByRoleIdAsync(response.RoleId);
                var businessRules = await FormBusinessRulesService.GetFormBusinessRulesAsync();
                SessionContext.LoadPermissions(permissions, businessRules);

                NavigationManager.NavigateTo("/home");
            }
            else
            {
                errorMessage = "Invalid username/email or password.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Login failed for user {Username}", loginModel.Username);
            errorMessage = "Login failed. Please try again later.";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }

    public class LoginModel
    {
        [Required(ErrorMessage = "Username is required")]
        public string Username { get; set; } = "";

        [Required(ErrorMessage = "Password is required")]
        public string Password { get; set; } = "";
    }
}