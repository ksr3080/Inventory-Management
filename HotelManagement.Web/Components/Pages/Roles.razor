@page "/role"
@using HotelManagement.Interface
@using HotelManagement.Service
@using HotelManagement.Shared.DTOs.Roles
@using HotelManagement.Shared.Helper.FormAccessCode
@using HotelManagement.ViewModels
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject IRoleService RoleService
@inject SessionContext SessionContext

<PageTitle>Role</PageTitle>
@if (!CanView(Route))
{
    <div class="container-fluid mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="alert alert-danger text-center">
                    <h4>Access Denied</h4>
                    <p>You don't have permission to access this page.</p>
                    <Button Color="ButtonColor.Primary" @onclick="GoHome">
                        Go to Home
                    </Button>
                </div>
            </div>
        </div>
    </div>
}
else
{
    @if (isLoading)
    {
        <div class="text-center">
            <Spinner Type="SpinnerType.Border" />
        </div>
    }
    else
    {
        <div class="container-fluid">
            <div class="row mb-3">
                <div class="col">
                    <h3><Icon Name="IconName.FilePerson" />Role</h3>
                </div>
                <div class="col-auto">
                    <span title="@(!CanCreate(Route) ? "You do not have permission to perform this action." : "")">
                        <Button Color="ButtonColor.Primary" @onclick="ShowAddModal" Disabled="@(!CanCreate(Route))">
                            <Icon Name="IconName.Plus" /> Add New
                        </Button>
                    </span>
                </div>
            </div>

            <Grid TItem="RoleModel"
                  Class="table table-hover table-bordered table-striped"
                  Data="roleList"
                  AllowPaging="true"
                  PageSize="10"
                  Responsive="true"
                  AllowFiltering="true"
                  AllowSorting="true"
                  @ref=roleGrid>

                <GridColumn TItem="RoleModel" HeaderText="No" Filterable=false>
                    @(roleList.IndexOf(context) + 1)
                </GridColumn>
                <GridColumn TItem="RoleModel" HeaderText="Name" PropertyName="Name" SortString="Name" SortKeySelector="item => item.Name" FilterTextboxWidth="100">
                    @context.Name
                </GridColumn>
                <GridColumn TItem="RoleModel" HeaderText="Description" PropertyName="Description" Filterable=false>
                    @context.Description
                </GridColumn>
                @if (isShowRoleLevel)
                {
                    <GridColumn TItem="RoleModel" HeaderText="Role Level" PropertyName="RoleLevel" SortString="RoleLevel" SortKeySelector="item => item.RoleLevel" FilterTextboxWidth="80">
                        <span style="color:@(context.RoleLevel < 5 ? "red" : "")">
                            @context.RoleLevel
                        </span>
                    </GridColumn>
                }
                <GridColumn TItem="RoleModel" HeaderText="Status" PropertyName="IsActive" SortString="IsActive" SortKeySelector="item => item.IsActive" Sortable=false>
                    @if (context.IsActive)
                    {
                        <Badge Color="BadgeColor.Success">Active</Badge>
                    }
                    else
                    {
                        <Badge Color="BadgeColor.Danger">Inactive</Badge>
                    }
                </GridColumn>

                <GridColumn TItem="RoleModel" HeaderText="Actions" Filterable=false>
                    <div class="d-flex gap-1 justify-content-start">
                        <span title="@(!CanEdit(Route) ? "You do not have permission to perform this action." : "")">
                            <LoadingButton Class="text-nowrap" Color="ButtonColor.Warning" Size="ButtonSize.Small"
                                           Disabled="@(!CanEdit(Route))"
                                           OnClick="() => ShowEditModal(context)">
                                <Icon Name="IconName.PencilSquare" /> Edit
                            </LoadingButton>
                        </span>

                        <span title="@(!CanDelete(Route) ? "You do not have permission to perform this action." : "")">
                            <LoadingButton Class="text-nowrap" Color="ButtonColor.Danger" Size="ButtonSize.Small"
                                           Disabled="@(!CanDelete(Route))"
                                           OnClick="() => DeleteRole(context.Id)">
                                <Icon Name="IconName.Trash" /> Delete
                            </LoadingButton>
                        </span>

                        <span title="@(!CanPermission(Route) ? "You do not have permission to perform this action." : "")">
                            <Button Class="text-nowrap" Color="ButtonColor.Info" Size="ButtonSize.Small"
                                    Disabled="@(!CanPermission(Route))"
                                    @onclick="() => NavigateToPermissions(context.Id)">
                                <Icon Name="IconName.ShieldLock" /> Permissions
                            </Button>
                        </span>
                    </div>
                </GridColumn>
            </Grid>
        </div>
    }

    <Modal @ref="modal" Title="@modalTitle" Size="ModalSize.Regular" UseStaticBackdrop>
        <BodyTemplate>
            <EditForm EditContext="@editContext" OnValidSubmit="SaveRole">
                <DataAnnotationsValidator />

                <div class="row">
                    <div class="col-12 mb-3">
                        <label class="form-label">Name <span class="text-danger">*</span></label>
                        <InputText class="form-control" @bind-Value="roleModel.Name" @oninput="(e) => HandleNameChangeAsync(e.Value?.ToString())" />
                        <ValidationMessage For="@(() => roleModel.Name)" />
                    </div>
                </div>
                @if (isShowRoleLevel)
                {
                    <div class="row">
                        <div class="col-12 mb-3">
                            <label class="form-label">Role Level </label>
                            <InputNumber class="form-control" @bind-Value="roleModel.RoleLevel" min="0" />
                        </div>
                    </div>
                }
                @if (roleModel.Id > 0)
                {
                    <div class="mb-3">
                        <InputCheckbox @bind-Value="roleModel.IsActive" /> Active
                    </div>
                }
                <div class="text-end">
                    <Button Color="ButtonColor.Secondary" @onclick="HideModal">Cancel</Button>
                    <Button Color="ButtonColor.Primary" Type="ButtonType.Submit">Save</Button>
                </div>
            </EditForm>
        </BodyTemplate>
    </Modal>
}
@code {
    private Modal modal { get; set; } = default!;
    private bool isEditMode = false;
    private bool isLoading = true;
    private RoleModel roleModel { get; set; } = new();
    private string modalTitle = "Add Roles";
    private Grid<RoleModel> roleGrid = default!;
    private List<RoleModel> roleList = new();
    private string Route = "/role";
    private EditContext editContext { get; set; } = default!;
    private ValidationMessageStore validationMessage = default!;
    private bool isShowRoleLevel = false;
    private bool isSaveBtnLoading = false;

    // ── Permission checks — fully dynamic ──
    private bool CanView(string route) => SessionContext.HasPermission(FormAccessCode.ROLE, Form_BusinessRules.VIEW);
    private bool CanCreate(string route) => SessionContext.HasPermission(FormAccessCode.ROLE, Form_BusinessRules.ADD);
    private bool CanEdit(string route) => SessionContext.HasPermission(FormAccessCode.ROLE, Form_BusinessRules.EDIT);
    private bool CanDelete(string route) => SessionContext.HasPermission(FormAccessCode.ROLE, Form_BusinessRules.DELETE);
    private bool CanPermission(string route) => SessionContext.HasPermission(FormAccessCode.ROLE, Form_BusinessRules.ISDISPLAYPERMISSION);
    private bool IsAuthenticated => SessionContext.IsAuthenticated;
    private int CurrentUserId => SessionContext.UserId;
    private string CurrentUserRoleId => SessionContext.RoleId.ToString();

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        await base.OnInitializedAsync();
        await LoadRole();
        isLoading = false;
    }

    private async Task LoadRole()
    {
        try
        {
            isShowRoleLevel = true;
            var result = await RoleService.GetRolesAsync();
            roleList = result.Select(r => new RoleModel
            {
                Id = r.Id,
                Name = r.RoleName ?? string.Empty,
                RoleLevel = r.RoleLevel ?? 0,
                IsActive = r.IsActive
            }).ToList();
        }
        catch (Exception)
        {
            roleList = [];
        }
    }

    public void InitializeEditContextAsync()
    {
        editContext = new EditContext(roleModel);
        validationMessage = new ValidationMessageStore(editContext);
    }

    private async Task ShowAddModal()
    {
        modalTitle = "Add Role";
        isEditMode = false;
        roleModel = new RoleModel()
        {
            CreatedBy = Convert.ToInt32(CurrentUserId),
            IsActive = true
        };
        isShowRoleLevel = true;
        InitializeEditContextAsync();
        await modal.ShowAsync();
    }
    private async Task ShowEditModal(RoleModel editRole)
    {
        modalTitle = "Edit Role";
        isEditMode = true;
        isShowRoleLevel = true;
        roleModel = new RoleModel
        {
            Id = editRole.Id,
            Name = editRole.Name,
            RoleLevel = editRole.RoleLevel,
            IsActive = editRole.IsActive,
            UpdatedBy = Convert.ToInt32(CurrentUserId),
        };
        InitializeEditContextAsync();
        await modal.ShowAsync();
    }
    private async Task SaveRole()
    {
        if (isSaveBtnLoading) return;
        try
        {
            isSaveBtnLoading = true;
            if (!editContext.Validate()) return;
            await ValidateNameAsync();
            if (editContext.GetValidationMessages().Any())
                return;

            if (isEditMode)
            {
                var updateDto = new UpdateRoleDTO
                {
                    Id = roleModel.Id,
                    RoleName = roleModel.Name,
                    RoleLevel = roleModel.RoleLevel,
                    IsActive = roleModel.IsActive
                };
                await RoleService.UpdateRoleAsync(updateDto);
            }
            else
            {
                var createDto = new CreateRoleDTO
                {
                    RoleName = roleModel.Name,
                    RoleLevel = roleModel.RoleLevel,
                    IsActive = roleModel.IsActive
                };
                await RoleService.CreateRoleAsync(createDto);
            }
            await HideModal();
            await LoadRole();
            if (roleGrid != null)
                await roleGrid.RefreshDataAsync();
        }
        catch (Exception) { }
        finally
        {
            isSaveBtnLoading = false;
        }
    }

    private async Task DeleteRole(int id)
    {
        try
        {
            bool isConfirm = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete?");
            if (isConfirm)
            {
                await RoleService.DeleteRoleAsync(id);
                await LoadRole();
                if (roleGrid != null)
                    await roleGrid.RefreshDataAsync();
            }
        }
        catch (Exception)
        {

        }
    }

    private async Task HideModal()
    {
        await modal.HideAsync();
    }
    private async Task ValidateDuplicateRoleName()
    {
        validationMessage.Clear(() => roleModel.Name);
        if (!string.IsNullOrEmpty(roleModel.Name))
        {
            var isRoleNameUnique = !roleList.Any(r => r.Name.Equals(roleModel.Name, StringComparison.OrdinalIgnoreCase) && r.Id != roleModel.Id);
            if (!isRoleNameUnique)
            {
                validationMessage.Add(() => roleModel.Name, "This Role Already Exists");
            }
            editContext.NotifyValidationStateChanged();
        }
        await Task.CompletedTask;
    }

    private async Task ValidateNameAsync()
    {
        validationMessage.Clear(() => roleModel.Name);
        if (string.IsNullOrWhiteSpace(roleModel.Name))
        {
            validationMessage.Add(() => roleModel.Name, "Role name is required");
            editContext.NotifyValidationStateChanged();
        }
        await Task.CompletedTask;
    }
    private async Task HandleNameChangeAsync(string? newValue)
    {
        roleModel.Name = newValue ?? string.Empty;
        try
        {
            await ValidateNameAsync();
        }
        catch (Exception ex)
        {

        }
    }
    private void NavigateToPermissions(int roleId)
    {
        NavigationManager.NavigateTo($"/role/form-permission/{roleId}");
    }
    private void GoHome()
    {
        NavigationManager.NavigateTo("/");
    }
}
